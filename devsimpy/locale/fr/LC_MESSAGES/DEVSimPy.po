#: devsimpy.py:3143
msgid ""
"\t To close DEVSimPy: python devsimpy.py close|quit|autoquit|autoclose\n"
msgstr ""
"\t Pour fermer DEVSimPy : python devsimpy.py close|quit|autoquit|autoclose"

#: devsimpy.py:3119
msgid "\t To execute DEVSimPy GUI: python devsimpy.py\n"
msgstr "\t Pour exécuter DEVSimPy : python devsimpy.py\n"

#: devsimpy.py:3120
msgid "\t To execute DEVSimPy No GUI: python devsimpy.py --nogui\n"
msgstr ""
"\t Pour exécuter DEVSimPy sans interface graphique : python devsimpy.py --nogui"

#: devsimpy.py:3141
msgid "\t To execute DEVSimPy cleaner: python devsimpy.py -c|-clean\n"
msgstr "\t Pour réinitialiser DEVSimPy : python devsimpy.py -c|-clean\n"

#: devsimpy.py:3122
msgid ""
"\t To load an existing dsp file / all .dsp files / all .yaml files in a directory: \n"
"\t\t$ python devsimpy.py <absolute path of .dsp file/*.dsp/*.yaml>\n"
msgstr ""
"\t Pour charger un fichier dsp existant / tous les fichiers .dsp / tous les fichiers .yaml d'un répertoire : \n"
"\t\t$ python devsimpy.py <chemin absolu du fichier .dsp/*.dsp/*.yaml>"

#: devsimpy.py:3127
msgid ""
"\t To load an existing dsp with a simulation frame initialized with a time 10: \n"
"\t\t$ python devsimpy.py <absolute path of the .dsp file> 10\n"
msgstr ""
"\t Pour charger un dsp existant avec une fenêtre de simulation initialisée à un temps 10 : \n"
"\t\t$ python devsimpy.py <chemin absolu du fichier .dsp> 10"

#: devsimpy.py:3132
msgid ""
"\t To load an existing dsp with a simulation frame initialized with no time limit: \n"
"\t\t$ python devsimpy.py <absolute path of the .dsp file> ntl/inf/infinity\n"
msgstr ""
"\t Pour charger un dsp existant avec une fenêtre de simulation initialisée sans limite de temps : \n"
"\t\t$ python devsimpy.py <chemin absolu du fichier .dsp> ntl/inf/infinity"

#: devsimpy.py:3137
msgid ""
"\t To start simulation: \n"
"\t\t$ python devsimpy.py <absolute path of the .dsp file> ntl/inf/infinity autostart|start|go/go\n"
msgstr ""
"\t Pour démarrer la simulation : \n"
"\t\t$ python devsimpy.py <chemin absolu du fichier .dsp> ntl/inf/infinity autostart|start|go/go"

